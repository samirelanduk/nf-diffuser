/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for Hugging Face model paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines Stable Diffusion 1.5 checkpoints and image QC models using Hugging Face
    paths, pinned to a specific commit of each repository.
    Can be used by any config that customises the base path using:
        $params.hf_base / --hf_base
----------------------------------------------------------------------------------------
*/

params.models = [
    'SD1.5' : [
        model : "${params.hf_base}/stable-diffusion-v1-5/stable-diffusion-v1-5/resolve/451f4fe16113bff5a5d2269ed5ad43b0592e9a14/v1-5-pruned-emaonly.safetensors",
