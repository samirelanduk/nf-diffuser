nextflow_pipeline {

    name "Test pipeline validation failures"
    script "../main.nf"
    tag "pipeline"
    tag "validation"

    test("Fails when --input and --prompt are both missing") {

        when {
            params {
                outdir = "$outputDir"
                input  = null
                prompt = null
                model  = "https://raw.githubusercontent.com/samirelanduk/pydiffuse/v0.4.1/tests/cli/models/sd15.safetensors"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains("Provide exactly one of '--input samplesheet.csv' or '--prompt \"Some description\"'.") } }
            )
        }
    }

    test("Fails when --input and --prompt are both provided") {

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/tests/data/samplesheet.csv"
                prompt = "A photo of a tree"
                model  = "https://raw.githubusercontent.com/samirelanduk/pydiffuse/v0.4.1/tests/cli/models/sd15.safetensors"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains("Provide exactly one of '--input samplesheet.csv' or '--prompt \"Some description\"'.") } }
            )
        }
    }

    test("Fails when --model and --model_name are missing") {

        when {
            params {
                outdir     = "$outputDir"
                input      = "${projectDir}/tests/data/samplesheet.csv"
                model      = null
                model_name = null
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains("Model weights not specified with e.g. '--model_name SD1.5' or '--model model.safetensors'.") } }
            )
        }
    }

    test("Fails when --model_name is not in the catalogue") {

        when {
            params {
                outdir     = "$outputDir"
                input      = "${projectDir}/tests/data/samplesheet.csv"
                model_name = "SD9.9"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains("Model 'SD9.9' not found in any config files provided to the pipeline.") } },
                { assert (workflow.stdout + workflow.stderr).any { it.contains('SD1.5') } }
            )
        }
    }

    test("Fails when --model_name is given but the catalogue is ignored") {

        when {
            params {
                outdir     = "$outputDir"
                input      = "${projectDir}/tests/data/samplesheet.csv"
                model      = null
                model_name = "SD1.5"
                hf_ignore  = true
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains("Model weights not specified") } }
            )
        }
    }

    test("Fails when --model does not have a .safetensors extension") {

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/tests/data/samplesheet.csv"
                model  = "${projectDir}/tests/data/samplesheet.csv"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains('ERROR ~ Validation of pipeline parameters failed!') } },
                { assert workflow.stderr.any { it.contains('does not match regular expression [^\\S+\\.safetensors$]') } }
            )
        }
    }

    test("Fails when --model path does not exist") {

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/tests/data/samplesheet.csv"
                model  = "${projectDir}/tests/data/does_not_exist.safetensors"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains('ERROR ~ Validation of pipeline parameters failed!') } },
                { assert workflow.stderr.any { it.contains("does_not_exist.safetensors' does not exist") } }
            )
        }
    }

    test("Fails when --input does not have a .csv extension") {

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/assets/schema_input.json"
                model  = "https://raw.githubusercontent.com/samirelanduk/pydiffuse/v0.4.1/tests/cli/models/sd15.safetensors"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains('ERROR ~ Validation of pipeline parameters failed!') } },
                { assert workflow.stderr.any { it.contains('does not match regular expression [^\\S+\\.csv$]') } }
            )
        }
    }

    test("Fails when --input path does not exist") {

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/tests/data/does_not_exist.csv"
                model  = "https://raw.githubusercontent.com/samirelanduk/pydiffuse/v0.4.1/tests/cli/models/sd15.safetensors"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains('ERROR ~ Validation of pipeline parameters failed!') } },
                { assert workflow.stderr.any { it.contains("does_not_exist.csv' does not exist") } }
            )
        }
    }

    test("Fails when a samplesheet row is missing the sample name") {

        setup {
            def sheet = new File("$launchDir/missing_sample.csv")
            sheet.parentFile.mkdirs()
            sheet.text = """\
                sample,prompt,negative_prompt,width,height
                ,A photo of a tree,blurry,800,600
                """.stripIndent()
        }

        when {
            params {
                outdir = "$outputDir"
                input  = "$launchDir/missing_sample.csv"
                model  = "https://raw.githubusercontent.com/samirelanduk/pydiffuse/v0.4.1/tests/cli/models/sd15.safetensors"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains('ERROR ~ Validation of pipeline parameters failed!') } },
                { assert workflow.stderr.any { it.contains('Missing required field(s): sample') } }
            )
        }
    }

    test("Fails when a sample name contains spaces") {

        setup {
            def sheet = new File("$launchDir/spaces_sample.csv")
            sheet.parentFile.mkdirs()
            sheet.text = """\
                sample,prompt,negative_prompt,width,height
                bad sample,A photo of a tree,blurry,800,600
                """.stripIndent()
        }

        when {
            params {
                outdir = "$outputDir"
                input  = "$launchDir/spaces_sample.csv"
                model  = "https://raw.githubusercontent.com/samirelanduk/pydiffuse/v0.4.1/tests/cli/models/sd15.safetensors"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stderr.any { it.contains('Sample name must be provided and cannot contain spaces') } }
            )
        }
    }

    test("Fails when sample names are not unique") {

        setup {
            def sheet = new File("$launchDir/duplicate_sample.csv")
            sheet.parentFile.mkdirs()
            sheet.text = """\
                sample,prompt,negative_prompt,width,height
                TREE,A photo of a tree,blurry,800,600
                TREE,A painting of a tree,blurry,800,600
                """.stripIndent()
        }

        when {
            params {
                outdir = "$outputDir"
                input  = "$launchDir/duplicate_sample.csv"
                model  = "https://raw.githubusercontent.com/samirelanduk/pydiffuse/v0.4.1/tests/cli/models/sd15.safetensors"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains('ERROR ~ Validation of pipeline parameters failed!') } },
                { assert workflow.stderr.any { it.contains('Detected duplicate entries') && it.contains('TREE') } }
            )
        }
    }

    test("Fails when a samplesheet row is missing the prompt") {

        setup {
            def sheet = new File("$launchDir/missing_prompt.csv")
            sheet.parentFile.mkdirs()
            sheet.text = """\
                sample,prompt,negative_prompt,width,height
                TREE,,blurry,800,600
                """.stripIndent()
        }

        when {
            params {
                outdir = "$outputDir"
                input  = "$launchDir/missing_prompt.csv"
                model  = "https://raw.githubusercontent.com/samirelanduk/pydiffuse/v0.4.1/tests/cli/models/sd15.safetensors"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains('ERROR ~ Validation of pipeline parameters failed!') } },
                { assert workflow.stderr.any { it.contains('Missing required field(s): prompt') } }
            )
        }
    }

    test("Fails when the width is not an integer") {

        setup {
            def sheet = new File("$launchDir/bad_width.csv")
            sheet.parentFile.mkdirs()
            sheet.text = """\
                sample,prompt,negative_prompt,width,height
                TREE,A photo of a tree,blurry,not_a_number,600
                """.stripIndent()
        }

        when {
            params {
                outdir = "$outputDir"
                input  = "$launchDir/bad_width.csv"
                model  = "https://raw.githubusercontent.com/samirelanduk/pydiffuse/v0.4.1/tests/cli/models/sd15.safetensors"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains('ERROR ~ Validation of pipeline parameters failed!') } },
                { assert workflow.stderr.any { it.contains("Error for field 'width'") && it.contains('Width must be an integer') } }
            )
        }
    }

    test("Fails when the height is not an integer") {

        setup {
            def sheet = new File("$launchDir/bad_height.csv")
            sheet.parentFile.mkdirs()
            sheet.text = """\
                sample,prompt,negative_prompt,width,height
                TREE,A photo of a tree,blurry,800,not_a_number
                """.stripIndent()
        }

        when {
            params {
                outdir = "$outputDir"
                input  = "$launchDir/bad_height.csv"
                model  = "https://raw.githubusercontent.com/samirelanduk/pydiffuse/v0.4.1/tests/cli/models/sd15.safetensors"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains('ERROR ~ Validation of pipeline parameters failed!') } },
                { assert workflow.stderr.any { it.contains("Error for field 'height'") && it.contains('Height must be an integer') } }
            )
        }
    }

    test("Fails when the width is not a whole number") {

        setup {
            def sheet = new File("$launchDir/fractional_width.csv")
            sheet.parentFile.mkdirs()
            sheet.text = """\
                sample,prompt,negative_prompt,width,height
                TREE,A photo of a tree,blurry,800.5,600
                """.stripIndent()
        }

        when {
            params {
                outdir = "$outputDir"
                input  = "$launchDir/fractional_width.csv"
                model  = "https://raw.githubusercontent.com/samirelanduk/pydiffuse/v0.4.1/tests/cli/models/sd15.safetensors"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains('ERROR ~ Validation of pipeline parameters failed!') } },
                { assert workflow.stderr.any { it.contains("Error for field 'width'") && it.contains('Width must be an integer') } }
            )
        }
    }

    test("Fails when the height is not a whole number") {

        setup {
            def sheet = new File("$launchDir/fractional_height.csv")
            sheet.parentFile.mkdirs()
            sheet.text = """\
                sample,prompt,negative_prompt,width,height
                TREE,A photo of a tree,blurry,800,600.5
                """.stripIndent()
        }

        when {
            params {
                outdir = "$outputDir"
                input  = "$launchDir/fractional_height.csv"
                model  = "https://raw.githubusercontent.com/samirelanduk/pydiffuse/v0.4.1/tests/cli/models/sd15.safetensors"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains('ERROR ~ Validation of pipeline parameters failed!') } },
                { assert workflow.stderr.any { it.contains("Error for field 'height'") && it.contains('Height must be an integer') } }
            )
        }
    }

    test("Fails when steps is not a number") {

        setup {
            def sheet = new File("$launchDir/bad_steps.csv")
            sheet.parentFile.mkdirs()
            sheet.text = """\
                sample,prompt,negative_prompt,width,height,steps,cfg,sampler,schedule
                TREE,A photo of a tree,blurry,800,600,not_a_number,7.5,euler,karras
                """.stripIndent()
        }

        when {
            params {
                outdir = "$outputDir"
                input  = "$launchDir/bad_steps.csv"
                model  = "https://raw.githubusercontent.com/samirelanduk/pydiffuse/v0.4.1/tests/cli/models/sd15.safetensors"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains('ERROR ~ Validation of pipeline parameters failed!') } },
                { assert workflow.stderr.any { it.contains("Error for field 'steps'") && it.contains('Steps must be an integer') } }
            )
        }
    }

    test("Fails when steps is not a whole number") {

        setup {
            def sheet = new File("$launchDir/fractional_steps.csv")
            sheet.parentFile.mkdirs()
            sheet.text = """\
                sample,prompt,negative_prompt,width,height,steps,cfg,sampler,schedule
                TREE,A photo of a tree,blurry,800,600,20.5,7.5,euler,karras
                """.stripIndent()
        }

        when {
            params {
                outdir = "$outputDir"
                input  = "$launchDir/fractional_steps.csv"
                model  = "https://raw.githubusercontent.com/samirelanduk/pydiffuse/v0.4.1/tests/cli/models/sd15.safetensors"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains('ERROR ~ Validation of pipeline parameters failed!') } },
                { assert workflow.stderr.any { it.contains("Error for field 'steps'") && it.contains('Steps must be an integer') } }
            )
        }
    }

    test("Fails when steps is less than 1") {

        setup {
            def sheet = new File("$launchDir/low_steps.csv")
            sheet.parentFile.mkdirs()
            sheet.text = """\
                sample,prompt,negative_prompt,width,height,steps,cfg,sampler,schedule
                TREE,A photo of a tree,blurry,800,600,0,7.5,euler,karras
                """.stripIndent()
        }

        when {
            params {
                outdir = "$outputDir"
                input  = "$launchDir/low_steps.csv"
                model  = "https://raw.githubusercontent.com/samirelanduk/pydiffuse/v0.4.1/tests/cli/models/sd15.safetensors"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains('ERROR ~ Validation of pipeline parameters failed!') } },
                { assert workflow.stderr.any { it.contains("Error for field 'steps'") && it.contains('Steps must be an integer greater than or equal to 1') } }
            )
        }
    }

    test("Fails when CFG is not a number") {

        setup {
            def sheet = new File("$launchDir/bad_cfg.csv")
            sheet.parentFile.mkdirs()
            sheet.text = """\
                sample,prompt,negative_prompt,width,height,steps,cfg,sampler,schedule
                TREE,A photo of a tree,blurry,800,600,20,high,euler,karras
                """.stripIndent()
        }

        when {
            params {
                outdir = "$outputDir"
                input  = "$launchDir/bad_cfg.csv"
                model  = "https://raw.githubusercontent.com/samirelanduk/pydiffuse/v0.4.1/tests/cli/models/sd15.safetensors"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains('ERROR ~ Validation of pipeline parameters failed!') } },
                { assert workflow.stderr.any { it.contains("Error for field 'cfg'") && it.contains('CFG must be a number greater than or equal to 1') } }
            )
        }
    }

    test("Fails when CFG is less than 1") {

        setup {
            def sheet = new File("$launchDir/low_cfg.csv")
            sheet.parentFile.mkdirs()
            sheet.text = """\
                sample,prompt,negative_prompt,width,height,steps,cfg,sampler,schedule
                TREE,A photo of a tree,blurry,800,600,20,0.5,euler,karras
                """.stripIndent()
        }

        when {
            params {
                outdir = "$outputDir"
                input  = "$launchDir/low_cfg.csv"
                model  = "https://raw.githubusercontent.com/samirelanduk/pydiffuse/v0.4.1/tests/cli/models/sd15.safetensors"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains('ERROR ~ Validation of pipeline parameters failed!') } },
                { assert workflow.stderr.any { it.contains("Error for field 'cfg'") && it.contains('CFG must be a number greater than or equal to 1') } }
            )
        }
    }

    test("Fails when the sampler is not a recognised algorithm") {

        setup {
            def sheet = new File("$launchDir/bad_sampler.csv")
            sheet.parentFile.mkdirs()
            sheet.text = """\
                sample,prompt,negative_prompt,width,height,steps,cfg,sampler,schedule
                TREE,A photo of a tree,blurry,800,600,20,7.5,ancestral,karras
                """.stripIndent()
        }

        when {
            params {
                outdir = "$outputDir"
                input  = "$launchDir/bad_sampler.csv"
                model  = "https://raw.githubusercontent.com/samirelanduk/pydiffuse/v0.4.1/tests/cli/models/sd15.safetensors"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains('ERROR ~ Validation of pipeline parameters failed!') } },
                { assert workflow.stderr.any { it.contains("Error for field 'sampler'") && it.contains('Sampler must be a string and must be one of the following: euler, heun') } }
            )
        }
    }

    test("Fails when the schedule is not a recognised algorithm") {

        setup {
            def sheet = new File("$launchDir/bad_schedule.csv")
            sheet.parentFile.mkdirs()
            sheet.text = """\
                sample,prompt,negative_prompt,width,height,steps,cfg,sampler,schedule
                TREE,A photo of a tree,blurry,800,600,20,7.5,euler,linear
                """.stripIndent()
        }

        when {
            params {
                outdir = "$outputDir"
                input  = "$launchDir/bad_schedule.csv"
                model  = "https://raw.githubusercontent.com/samirelanduk/pydiffuse/v0.4.1/tests/cli/models/sd15.safetensors"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains('ERROR ~ Validation of pipeline parameters failed!') } },
                { assert workflow.stderr.any { it.contains("Error for field 'schedule'") && it.contains('Schedule must be a string and must be one of the following: karras, exponential') } }
            )
        }
    }

    test("Fails when there is no CLIPScore model") {

        when {
            params {
                outdir    = "$outputDir"
                input     = "${projectDir}/tests/data/samplesheet.csv"
                model     = "https://raw.githubusercontent.com/samirelanduk/pydiffuse/v0.4.1/tests/cli/models/sd15.safetensors"
                qc_models = [CLIPScore: [files: []]]
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains("CLIPScore model not found. Provide it with '--clipscore_model <directory>', or skip it with '--skip_clipscore'.") } }
            )
        }
    }

    test("Fails when there is no PickScore model") {

        when {
            params {
                outdir         = "$outputDir"
                input          = "${projectDir}/tests/data/samplesheet.csv"
                model          = "https://raw.githubusercontent.com/samirelanduk/pydiffuse/v0.4.1/tests/cli/models/sd15.safetensors"
                qc_models      = [PickScore: [files: []]]
                skip_clipscore = true
                run_pickscore  = true
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains("PickScore model not found. Provide it with '--pickscore_model <directory>'.") } }
            )
        }
    }

    test("Fails when --clipscore_model does not exist") {

        when {
            params {
                outdir          = "$outputDir"
                input           = "${projectDir}/tests/data/samplesheet.csv"
                model           = "https://raw.githubusercontent.com/samirelanduk/pydiffuse/v0.4.1/tests/cli/models/sd15.safetensors"
                clipscore_model = "$launchDir/missing"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains('ERROR ~ Validation of pipeline parameters failed!') } },
                { assert workflow.stderr.any { it.contains("--clipscore_model") } }
            )
        }
    }
}
